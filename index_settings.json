{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s"
    }
  },
  "mappings": {
    "properties": {
      "file_name": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "file_path": {
        "type": "keyword"
      },
      "file_directory": {
        "type": "keyword"
      },
      "file_extension": {
        "type": "keyword"
      },
      "file_size": {
        "type": "long"
      },
      "created_date": {
        "type": "date"
      },
      "modified_date": {
        "type": "date"
      },
      "content": {
        "type": "text",
        "term_vector": "with_positions_offsets",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 1024
          }
        }
      }
    }
  }
}
